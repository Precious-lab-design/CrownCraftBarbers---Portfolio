@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="legal-hero">
    <div class="container">
        <p class="section-label">CROWN & CRAFT</p>

        <h1>PRIVACY<br />POLICY.</h1>

        <p>
            We respect your privacy and are committed to protecting the
            information you provide when using our website and booking system.
        </p>
    </div>
</section>

<section class="legal-section">
    <div class="container legal-container">

        <div class="legal-intro">

            <p class="section-label">YOUR PRIVACY</p>

            <h2>HOW WE HANDLE YOUR INFORMATION</h2>

            <p>
                This Privacy Policy explains how Crown & Craft Barbers
                collects, uses, stores and protects personal information
                submitted through this website.
            </p>

            <p>
                By using our website or submitting a booking, you acknowledge
                that you have read this Privacy Policy.
            </p>

        </div>

        <div class="legal-content">

            <!-- 01 -->
            <div class="legal-item">

                <span class="legal-number">01</span>

                <div>

                    <h3>INFORMATION WE COLLECT</h3>

                    <p>
                        When you make an appointment through our website,
                        we may collect information needed to process and
                        manage your booking.
                    </p>

                    <p>This may include:</p>

                    <ul>
                        <li>Full name</li>
                        <li>Telephone number</li>
                        <li>Email address</li>
                        <li>Selected service</li>
                        <li>Selected barber</li>
                        <li>Appointment date and time</li>
                        <li>Optional booking notes</li>
                    </ul>

                </div>

            </div>


            <!-- 02 -->
            <div class="legal-item">

                <span class="legal-number">02</span>

                <div>

                    <h3>HOW WE USE YOUR INFORMATION</h3>

                    <p>
                        Information submitted through the booking system may
                        be used to:
                    </p>

                    <ul>
                        <li>Process and manage appointments</li>
                        <li>Confirm booking details</li>
                        <li>Contact customers about their appointments</li>
                        <li>Manage barber availability</li>
                        <li>Provide requested services</li>
                        <li>Respond to customer enquiries</li>
                    </ul>

                    <p>
                        We will not use the information collected through the
                        booking form for unrelated purposes without an
                        appropriate lawful basis.
                    </p>

                </div>

            </div>


            <!-- 03 -->
            <div class="legal-item">

                <span class="legal-number">03</span>

                <div>

                    <h3>BOOKING INFORMATION</h3>

                    <p>
                        When an appointment is submitted, booking information
                        is stored in our booking system so that the appointment
                        can be managed and the selected barber's availability
                        can be maintained.
                    </p>

                    <p>
                        Customers should only provide information that is
                        relevant to their appointment and should avoid including
                        sensitive personal information in the optional notes
                        field.
                    </p>

                </div>

            </div>


            <!-- 04 -->
            <div class="legal-item">

                <span class="legal-number">04</span>

                <div>

                    <h3>CALENDAR INFORMATION</h3>

                    <p>
                        After completing a booking, customers may choose to
                        add their appointment to a calendar application such
                        as Google Calendar, Apple Calendar or Outlook.
                    </p>

                    <p>
                        The calendar event may contain appointment information
                        such as the Crown & Craft service, selected date and
                        time, barber, booking reference and business location.
                    </p>

                    <p>
                        Adding an appointment to a personal calendar is
                        optional and is controlled by the customer.
                    </p>

                </div>

            </div>


            <!-- 05 -->
            <div class="legal-item">

                <span class="legal-number">05</span>

                <div>

                    <h3>HOW WE PROTECT INFORMATION</h3>

                    <p>
                        We take reasonable steps to protect personal
                        information against unauthorised access, loss,
                        misuse or disclosure.
                    </p>

                    <p>
                        Access to booking information should be limited to
                        people who require it for legitimate business or
                        appointment-management purposes.
                    </p>

                    <p>
                        However, no website or electronic storage system can
                        guarantee absolute security.
                    </p>

                </div>

            </div>


            <!-- 06 -->
            <div class="legal-item">

                <span class="legal-number">06</span>

                <div>

                    <h3>SHARING OF INFORMATION</h3>

                    <p>
                        Crown & Craft does not sell customer personal
                        information.
                    </p>

                    <p>
                        Personal information may only be shared with a
                        service provider or other party where reasonably
                        necessary to operate the booking service, provide a
                        requested service, comply with a legal obligation or
                        protect the rights and security of the business or
                        its customers.
                    </p>

                </div>

            </div>


            <!-- 07 -->
            <div class="legal-item">

                <span class="legal-number">07</span>

                <div>

                    <h3>DATA RETENTION</h3>

                    <p>
                        Booking information may be retained for as long as
                        reasonably necessary to manage appointments, maintain
                        appropriate business records and meet applicable
                        legal or operational requirements.
                    </p>

                    <p>
                        Information that is no longer required should be
                        securely deleted or disposed of where appropriate.
                    </p>

                </div>

            </div>


            <!-- 08 -->
            <div class="legal-item">

                <span class="legal-number">08</span>

                <div>

                    <h3>YOUR RIGHTS</h3>

                    <p>
                        Subject to applicable South African law, customers
                        may have rights relating to their personal information,
                        including the right to request access to information
                        held about them and to request correction of inaccurate
                        information.
                    </p>

                    <p>
                        Customers may contact Crown & Craft regarding questions
                        or requests relating to their personal information.
                    </p>

                </div>

            </div>


            <!-- 09 -->
            <div class="legal-item">

                <span class="legal-number">09</span>

                <div>

                    <h3>COOKIES & LOCAL STORAGE</h3>

                    <p>
                        This website may use browser storage technologies such
                        as local storage to support certain website features.
                    </p>

                    <p>
                        For example, local storage may be used to remember
                        whether the first-visit promotional experience has
                        already been completed on a particular browser.
                    </p>

                    <p>
                        Browser storage can be cleared through the user's
                        browser settings.
                    </p>

                </div>

            </div>


            <!-- 10 -->
            <div class="legal-item">

                <span class="legal-number">10</span>

                <div>

                    <h3>CHANGES TO THIS POLICY</h3>

                    <p>
                        This Privacy Policy may be updated from time to time
                        to reflect changes to our website, booking system,
                        services or applicable requirements.
                    </p>

                    <p>
                        The updated version will be made available on this
                        website.
                    </p>

                </div>

            </div>


            <!-- 11 -->
            <div class="legal-item">

                <span class="legal-number">11</span>

                <div>

                    <h3>CONTACT US</h3>

                    <p>
                        If you have questions about this Privacy Policy or
                        how your information is handled, you can contact
                        Crown & Craft Barbers.
                    </p>

                    <p>
                        <strong>Address:</strong><br />
                        18 Market Street, Welkom,
                        Free State, South Africa
                    </p>

                    <p>
                        <strong>Phone:</strong><br />
                        +27 10 555 0188
                    </p>

                    <p>
                        <strong>Email:</strong><br />
                        hello@crowncraft.co.za
                    </p>

                </div>

            </div>

        </div>


        <div class="legal-footer-note">

            <p>
                <strong>Last updated:</strong> September 2026
            </p>

            <p>
                This Privacy Policy applies to the Crown & Craft Barbers
                website and its online booking experience.
            </p>

        </div>

    </div>
</section>