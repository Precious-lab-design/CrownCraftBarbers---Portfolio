@model IEnumerable<CrownCraftBarbers.Models.Barber>

@{
    ViewData["Title"] = "About Us";
}

<!-- ABOUT HERO -->

<section class="page-hero">
    <div class="container">
        <p class="section-label">THE CROWN & CRAFT STORY</p>

        <h1>
            WHERE TRADITION<br />
            MEETS MODERN STYLE.
        </h1>

        <p class="page-hero-text">
            Precision barbering, personal service and timeless technique
            in the heart of Welkom.
        </p>
    </div>

</section>

<!-- OUR STORY -->

<section class="section about-story">
    <div class="container about-story-grid">

        <div class="about-story-image">
            <img src="~/images/Salon.jpg"
                 alt="Crown & Craft Barbers interior"
                 />
        </div>

        <div class="about-story-content">

            <p class="section-label">OUR STORY</p>

            <h2>
                MORE THAN A HAIRCUT.
                IT'S YOUR CRAFT.
            </h2>

            <p>
                Crown & Craft Barbers was created around a simple idea:
                a great haircut should be more than a quick appointment.
            </p>

            <p>
                Our barbers combine traditional barbering techniques with
                contemporary styles to deliver precise, personalised
                grooming in a relaxed and welcoming environment.
            </p>

            <p>
                From your first visit to your regular appointment,
                every detail is considered — from the consultation
                to the final finish.
            </p>

            <p class="about-highlight">
                Come in for the craft. Leave with your crown.
            </p>

        </div>

    </div>

</section>

<!-- OUR APPROACH -->

<section class="section section-dark">
    <div class="container">

        <div class="section-heading centered">
            <p class="section-label">OUR APPROACH</p>

            <h2>
                THE CROWN & CRAFT EXPERIENCE
            </h2>

            <p>
                We believe great grooming starts with understanding
                the person in the chair.
            </p>
        </div>

        <div class="experience-grid">

            <div class="experience-card">
                <span class="experience-number">01</span>

                <h3>Precision</h3>

                <p>
                    Every appointment starts with understanding your
                    preferred style, followed by careful attention
                    to shape, detail and finish.
                </p>
            </div>

            <div class="experience-card">
                <span class="experience-number">02</span>

                <h3>Craft</h3>

                <p>
                    Our barbers combine classic barbering techniques
                    with modern styles to create a finish that feels
                    personal to you.
                </p>
            </div>

            <div class="experience-card">
                <span class="experience-number">03</span>

                <h3>Confidence</h3>

                <p>
                    The goal is simple: leave looking sharp,
                    feeling refreshed and ready for whatever
                    comes next.
                </p>
            </div>

        </div>

    </div>

</section>

<!-- OUR BARBERS -->

<section class="section">
    <div class="container">

        <div class="section-heading">
            <p class="section-label">MEET THE TEAM</p>

            <h2>
                THE BARBERS BEHIND THE CRAFT.
            </h2>

            <p>
                Skilled hands, individual styles and a shared
                commitment to precision.
            </p>
        </div>


        <div class="barber-grid">

            <article class="barber-card">

                <div class="barber-image">
                    <img src="~/images/Senior Barber.jpg"
                         alt="Marcus - Master Barber" />
                </div>

                <div class="barber-content">

                    <p class="barber-role">
                        Master Barber
                    </p>

                    <h3>
                        Marcus
                    </h3>

                    <p>
                        Known for precision cuts, classic styles and detailed finishing.
                    </p>

                </div>

            </article>


            <article class="barber-card">

                <div class="barber-image">
                    <img src="~/images/Master barber.jpg"
                         alt="Thabo - Senior Barber" />
                </div>

                <div class="barber-content">

                    <p class="barber-role">
                        Senior Barber
                    </p>

                    <h3>
                        Thabo
                    </h3>

                    <p>
                        Specialises in modern fades, beard grooming and sharp finishes.
                    </p>

                </div>

            </article>


            <article class="barber-card">

                <div class="barber-image">
                    <img src="~/images/Barber.jpg"
                         alt="Liam - Barber" />
                </div>

                <div class="barber-content">

                    <p class="barber-role">
                        Barber
                    </p>

                    <h3>
                        Liam
                    </h3>

                    <p>
                        Creates modern cuts with a relaxed and welcoming approach.
                    </p>

                </div>

            </article>

        </div>

    </div>

</section>

<!-- WHAT WE VALUE -->

<section class="section about-values">
    <div class="container">

        <div class="values-grid">

            <div>
                <p class="section-label">WHAT WE VALUE</p>

                <h2>
                    A BARBERSHOP BUILT
                    AROUND YOU.
                </h2>
            </div>

            <div class="values-list">

                <div class="value-item">
                    <span>01</span>

                    <div>
                        <h3>Personal Service</h3>
                        <p>
                            We take the time to understand what
                            you want before the first cut begins.
                        </p>
                    </div>
                </div>

                <div class="value-item">
                    <span>02</span>

                    <div>
                        <h3>Attention to Detail</h3>
                        <p>
                            From the first trim to the final finish,
                            we focus on the details that complete
                            the look.
                        </p>
                    </div>
                </div>

                <div class="value-item">
                    <span>03</span>

                    <div>
                        <h3>Welcoming Atmosphere</h3>
                        <p>
                            Whether you're a regular or visiting
                            for the first time, you'll have a relaxed
                            and professional experience.
                        </p>
                    </div>
                </div>

            </div>

        </div>

    </div>
  

</section>

<!-- CTA -->

<section class="cta">
    <div class="container">

        <p class="section-label">
            YOUR NEXT APPOINTMENT
        </p>

        <h2>
            READY FOR YOUR NEXT LOOK?
        </h2>

        <p>
            Choose your service, select your barber and reserve
            your chair at Crown & Craft Barbers.
        </p>

        <a asp-controller="Booking"
           asp-action="Index"
           class="btn btn-primary">
            BOOK YOUR CHAIR
        </a>

    </div>

</section>
