<!-- FIRST VISIT MODAL -->

<div id="welcomeModal"
     class="welcome-modal"
     aria-hidden="true">

    <div class="welcome-modal-overlay"></div>

    <div class="welcome-modal-content"
         role="dialog"
         aria-modal="true"
         aria-labelledby="welcomeModalTitle">

        <button type="button"
                class="welcome-modal-close"
                id="welcomeModalClose"
                aria-label="Close">
            &times;
        </button>

        <p class="section-label">
            CROWN & CRAFT
        </p>

        <h2 id="welcomeModalTitle">
            YOUR FIRST VISIT
            <span>DESERVES A LITTLE EXTRA.</span>
        </h2>

        <p class="welcome-modal-text">
            New to Crown & Craft? Enjoy <strong>10% off your first appointment</strong>
            and experience sharp cuts, clean craft and your style.
        </p>

        <div class="welcome-modal-actions">

            <a asp-controller="Booking"
               asp-action="Index"
               class="btn btn-primary">
                BOOK YOUR FIRST VISIT
            </a>

            <button type="button"
                    class="welcome-modal-secondary"
                    id="welcomeModalDismiss">
                MAYBE LATER
            </button>

        </div>

    </div>

</div> 