    @section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const modal = document.getElementById("welcomeModal");
                const closeButton = document.getElementById("welcomeModalClose");
                const dismissButton = document.getElementById("welcomeModalDismiss");
                const overlay = modal.querySelector(".welcome-modal-overlay");
                const bookingButton = modal.querySelector(".btn-primary");

                function openModal() {
                    modal.classList.add("is-visible");
                    modal.setAttribute("aria-hidden", "false");
                    document.body.classList.add("modal-open");
                }

                function closeModal() {
                    modal.classList.remove("is-visible");
                    modal.setAttribute("aria-hidden", "true");
                    document.body.classList.remove("modal-open");
                }

                // Show the popup unless the discount has already been used
                const discountUsed =
                    localStorage.getItem("crownCraftFirstVisitDiscountUsed");

                if (!discountUsed) {
                    setTimeout(openModal, 700);
                }

                // Close popup without marking discount as used
                closeButton.addEventListener("click", closeModal);
                dismissButton.addEventListener("click", closeModal);
                overlay.addEventListener("click", closeModal);

                // User clicked BOOK YOUR FIRST VISIT
                bookingButton.addEventListener("click", function () {

                    // Remember that the customer has chosen to use the offer
                    localStorage.setItem(
                        "crownCraftFirstVisitDiscountUsed",
                        "true"
                    );

                    closeModal();
                });

                // Close popup with Escape
                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        closeModal();
                    }
                });
            });
        </script>
    }
</section> 


